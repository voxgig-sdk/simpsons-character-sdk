          contract: {
            id: "GET /characters"
            json: "{\"operationId\":\"getCharacters\",\"parameters\":[{\"description\":\"Page number for pagination (20 items per page)\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"schema\":{\"default\":1,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"age\":39,\"birthdate\":\"1956-05-12\",\"gender\":\"Male\",\"id\":1,\"name\":\"Homer Simpson\",\"occupation\":\"Safety Inspector\",\"phrases\":[\"Doh!\",\"Why you little...!\",\"Woo-hoo!\"],\"portrait_path\":\"/character/1.webp\",\"status\":\"Alive\"}],\"schema\":{\"items\":{\"properties\":{\"age\":{\"description\":\"Age of the character\",\"example\":39,\"nullable\":true,\"type\":\"integer\"},\"birthdate\":{\"description\":\"Birthdate of the character in YYYY-MM-DD format\",\"example\":\"1956-05-12\",\"format\":\"date\",\"nullable\":true,\"type\":\"string\"},\"gender\":{\"description\":\"Gender of the character\",\"enum\":[\"Male\",\"Female\",\"Unknown\"],\"example\":\"Male\",\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the character\",\"example\":1,\"type\":\"integer\"},\"name\":{\"description\":\"Full name of the character\",\"example\":\"Homer Simpson\",\"type\":\"string\"},\"occupation\":{\"description\":\"Occupation or job title of the character\",\"example\":\"Safety Inspector\",\"nullable\":true,\"type\":\"string\"},\"phrases\":{\"description\":\"Famous quotes and catchphrases of the character\",\"example\":[\"Doh!\",\"Why you little...!\",\"Woo-hoo!\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"portrait_path\":{\"description\":\"Path to the character's portrait image (served via CDN)\",\"example\":\"/character/1.webp\",\"type\":\"string\"},\"status\":{\"description\":\"Current status of the character\",\"enum\":[\"Alive\",\"Deceased\",\"Unknown\"],\"example\":\"Alive\",\"type\":\"string\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with list of characters\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
